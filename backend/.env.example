# Copy this file to .env and fill in the values.
# Ask a teammate for the real DATABASE_URL and JWT_SECRET_KEY.

# Database — Supabase direct connection
# Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# JWT — any long random string works for local dev
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRATION_HOURS=32

# Redis — overridden automatically by docker compose, leave as-is
REDIS_URL=redis://localhost:6379/0

# Optional — Discord webhook for deploy notifications (leave blank to disable)
WEBHOOK_URL=
